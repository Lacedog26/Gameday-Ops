# Copy to .env and fill in the values for your Supabase project.
# These keys are exposed to the browser at build time — only put publishable
# (anon) keys here, NEVER service-role secrets.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Individual Pro Stripe Payment Links — leave blank to use the hardcoded
# defaults in src/lib/pro.ts. The webhook flips profiles.is_pro=true based
# on the `client_reference_id=<user_uuid>` query param the Pro page appends.
VITE_STRIPE_PRO_MONTHLY_URL=
VITE_STRIPE_PRO_ANNUAL_URL=

# B2B tier Stripe Payment Links — leave blank to use the hardcoded default
# in src/lib/teams.ts (which points at Pro Monthly for end-to-end testing).
# Each one should be a recurring monthly Payment Link priced at the tier value.
# The webhook routes these to activate_team_subscription_admin based on the
# `client_reference_id=team_<uuid>__<tier>` query param the web appends.
VITE_STRIPE_TEAM_URL=
VITE_STRIPE_GROWTH_URL=
VITE_STRIPE_ENTERPRISE_URL=

# Web Push (VAPID). ONLY the public key goes here — it's baked into the
# bundle and handed to PushManager.subscribe(), which is safe by design.
# The PRIVATE key must NEVER appear in this file under any name: it signs
# every push and one VITE_ prefix rename would ship it to every browser.
# It lives in Supabase Edge Function secrets exclusively:
#   supabase secrets set VAPID_PRIVATE_KEY=...
# Generate a pair with `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=
