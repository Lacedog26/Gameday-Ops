# .well-known files must bypass the SPA catch-all — without this,
# Netlify rewrites /.well-known/apple-app-site-association to
# /index.html and iOS rejects the AASA. Order is significant:
# the first matching rule wins.
/.well-known/*    /.well-known/:splat   200

# SPA fallback — serve index.html for any path that doesn't match a static
# file in dist/. Without this, deep-link URLs like /join/group/<code>,
# /pro, /c/<id>, etc. return Netlify's 404 page because Netlify treats
# them as static-file requests instead of letting React Router handle
# them client-side.
#
# Vite copies everything in public/ to the published dist/ folder, so
# Netlify reads this file at the root of the deployed site automatically.
#
# The 200 status code (not 301/302) is required for SPA routing —
# browsers need to receive the HTML with the original URL intact so
# React Router can read window.location and route correctly.
/*    /index.html   200
