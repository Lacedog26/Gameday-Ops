# Supabase backend (optional). When both are set, the app runs in cloud mode:
# state is stored in Supabase and synced live to every TV. Leave unset to run in
# single-device local mode. Set these in Vercel → Settings → Environment
# Variables (and in a local .env for development).

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: which shared board this deployment reads/writes. Defaults to
# "default". Use different ids to run separate boards from one project.
# VITE_BOARD_ID=default
